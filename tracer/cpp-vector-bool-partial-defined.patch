+// cpp-tutor: True iff EVERY accessible bit in [a, a+len) is undefined.
+// NOACCESS bytes are ignored. Used to tell a genuinely-uninitialized scalar
+// (all bits undefined) apart from a value with some live defined bits.
+static Bool pg_is_mem_fully_undefined ( Addr a, SizeT len )
+{
+   SizeT i;
+   for (i = 0; i < len; i++) {
+      UChar vbits8;
+      Bool  ok = get_vbits8(a + i, &vbits8);
+      if (!ok) continue;                 // NOACCESS byte: skip
+      if (vbits8 != V_BITS8_UNDEFINED)   // some defined bit present
+         return False;
+   }
+   return True;
+}
+
+// cpp-tutor: is_mem_defined variant for the trace pretty-printer. When memcheck
+// reports a value error but the region is only PARTIALLY undefined -- some live
+// bits are defined, e.g. a std::vector<bool> word whose unused high (padding)
+// bits are undefined -- return 8 so the printer emits the concrete value instead
+// of "<UNINITIALIZED>". A wholly-uninitialized scalar still returns MC_ValueErr.
+Int MC_(pg_is_mem_defined) ( Addr a, SizeT len,
+                             /*OUT*/Addr* bad_addr, /*OUT*/UInt* otag )
+{
+   MC_ReadResult res = is_mem_defined(a, len, bad_addr, otag);
+   if (res == MC_ValueErr && !pg_is_mem_fully_undefined(a, len))
+      return 8; // PG partial-defined
+   return res;
+}
+
 
