{"code":"#include <iostream>\n#include <vector>\nusing namespace std;\n\nint rob(vector<int> &nums){\n    if (nums.empty()) {\n        return 0;\n    }\n\n    vector<int> dp(nums.size(), 0); //dp[i] tells max money you can have after going thru 0-i houses\n    dp[0] = nums[0];\n    dp[1] = max(nums[0], nums[1]);\n    for (int i = 2; i < nums.size(); i++) {\n        dp[i] = max(nums[i] + dp[i-2], dp[i-1]);\n    }\n    return dp[nums.size()-1];\n}\n\nint robAltApproach(vector<int> &nums){\n    int prevTwo = 0;\n    int prevOne = 0;\n\n    for (int money : nums) {\n        int current = max(prevOne, money + prevTwo);\n\n        prevTwo = prevOne;\n        prevOne = current;\n    }\n\n    return prevOne;\n}\n\nint main(){\n    vector<int> nums = {1,2,3,1};\n    cout << rob(nums);\n    return 0;\n}\n","trace":[{"line":33,"event":"step_line","func_name":"main","stack_to_render":[{"encoded_locals":{},"frame_id":"0xFFF000B60_0","func_name":"main","is_highlighted":true,"is_parent":false,"is_zombie":false,"line":33,"ordered_varnames":[],"parent_frame_id_list":[],"unique_hash":"main_0xFFF000B60_0"}],"heap":{},"globals":{},"ordered_globals":[],"stdout":"","exception_msg":""},{"line":34,"event":"step_line","func_name":"main","stack_to_render":[{"encoded_locals":{},"frame_id":"0xFFF000B20_0","func_name":"main","is_highlighted":true,"is_parent":false,"is_zombie":false,"line":33,"ordered_varnames":[],"parent_frame_id_list":[],"unique_hash":"main_0xFFF000B20_0"}],"heap":{},"globals":{},"ordered_globals":[],"stdout":"","exception_msg":""},{"line":35,"event":"step_line","func_name":"main","stack_to_render":[{"encoded_locals":{"nums":["C_STRUCT","0xFFF000B48","vector<int, std::allocator<int> >",["<anon_field>",["C_STRUCT","0xFFF000B48","_Vector_base<int, std::allocator<int> >",["_M_impl",["C_STRUCT","0xFFF000B48","_Vector_impl",["_M_start",["C_DATA","0xFFF000B48","pointer","0x4B92040"]],["<anon_field>",["C_STRUCT","0xFFF000B48","allocator<int>",["<anon_field>",["C_STRUCT","0xFFF000B48"